# Coverage.py Configuration File
# This configures how code coverage is measured

[run]
# Measure branch coverage in addition to statement coverage
branch = True

# Files to include in coverage measurement
source = .

# Patterns for files to omit from coverage reports
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */__pycache__/*
    */venv/*
    */env/*
    */.venv/*
    manage.py
    mysite/wsgi.py
    mysite/asgi.py
    */site-packages/*
    */.elasticbeanstalk/*
    */.ebextensions/*

[report]
# Precision for coverage percentage
precision = 2

# Show lines that weren't executed
show_missing = True

# Ignore errors for source code that can't be found
ignore_errors = True

# Patterns for files to exclude from the report
exclude_lines =
    # Standard pragma to exclude lines
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:

    # Don't complain about abstract methods
    @abstractmethod

[html]
# Directory for HTML coverage reports
directory = htmlcov
